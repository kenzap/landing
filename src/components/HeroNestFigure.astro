---
// Animated hero for /articles/best-nesting-software-for-laser-cutting/:
// the 38-part job nests onto a fresh sheet, then a laser head cuts it part by part.
// Geometry is shared with RemnantGapFigure (scripts/remnant-gap-nest.py).
import nest from './remnant-gap-nest.json';

interface Props {
  categories: { num: string; category: string; tools: string; href: string }[];
  gapHref: string;
}
const { categories, gapHref } = Astro.props;

const MM = 5; // 1 SVG unit = 5 mm
const total = nest.full.length;
const utilPct = Math.round(nest.stats.full_used_util * 100);
const usedW = nest.stats.full_used_width_mm / MM; // in SVG units
const leftoverMm = 600 * MM - nest.stats.full_used_width_mm;
---

<figure class="hn" aria-labelledby="hn-caption">
  <div class="hn-card">
    <div class="hn-main">
      <div class="hn-head">
        <span class="hn-label">Fig. 1 · True-shape nest, {total} parts</span>
        <span class="hn-badge">2026 Fabrication guide</span>
      </div>

      <svg class="hn-svg" viewBox="-28 -34 664 372" role="img" aria-label={`A ${600 * MM} by ${300 * MM} mm sheet with ${total} true-shape nested parts being laser cut one by one.`}>
        <defs>
          <radialGradient id="hn-glow">
            <stop offset="0" stop-color="#ff6a3d" stop-opacity=".9" />
            <stop offset=".35" stop-color="#ff6a3d" stop-opacity=".35" />
            <stop offset="1" stop-color="#ff6a3d" stop-opacity="0" />
          </radialGradient>
        </defs>

        <g class="hn-dim">
          <line x1="0" y1="-16" x2="600" y2="-16" />
          <line x1="0" y1="-22" x2="0" y2="-10" />
          <line x1="600" y1="-22" x2="600" y2="-10" />
          <text x="300" y="-21" text-anchor="middle">{600 * MM} mm</text>
          <line x1="-16" y1="0" x2="-16" y2="300" />
          <line x1="-22" y1="0" x2="-10" y2="0" />
          <line x1="-22" y1="300" x2="-10" y2="300" />
          <text x="-21" y="150" text-anchor="middle" transform="rotate(-90 -21 150)">{300 * MM} mm</text>
        </g>

        <rect class="hn-sheet" width="600" height="300" pathLength="100" />

        <g class="hn-leftover" aria-hidden="true">
          <rect x={usedW + 1} y="1" width={600 - usedW - 2} height="298" />
          <text x={usedW + (600 - usedW) / 2} y="146" text-anchor="middle">LEFTOVER</text>
          <text x={usedW + (600 - usedW) / 2} y="162" text-anchor="middle">{leftoverMm} × {300 * MM}</text>
        </g>

        <g class="hn-parts">
          {nest.full.map((d, i) => <path class="hn-part" d={d} style={`--i:${i}`} />)}
        </g>
        <g class="hn-cuts" aria-hidden="true"></g>
        <path class="hn-rapid" d="M0,0" aria-hidden="true" />
        <g class="hn-head-dot" aria-hidden="true">
          <circle r="16" fill="url(#hn-glow)" />
          <circle r="2.6" class="hn-spark" />
        </g>
      </svg>

      <div class="hn-readout" aria-hidden="true">
        <span><b>{total}/{total}</b> parts nested</span>
        <span><b>{utilPct}%</b> utilization</span>
        <span><b>{(nest.stats.full_used_width_mm / 1000).toFixed(2)} m</b> length used</span>
        <span class="hn-progress">
          <b><span class="hn-count">0</span>/{total}</b> cut
          <i><em></em></i>
        </span>
      </div>
    </div>

    <nav class="hn-cats" aria-label="Categories evaluated">
      <span class="hn-label">Categories evaluated</span>
      <ol>
        {categories.map((c) => (
          <li>
            <a href={c.href}>
              <span class="hn-num">{c.num}</span>
              <span>
                <strong>{c.category.replace(/^The /, '')}</strong>
                <small>{c.tools}</small>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <a class="hn-gap" href={gapHref}>
        <span class="hn-label">The universal gap</span>
        <strong>Irregular remnant sheet nesting</strong>
        <span class="hn-arrow" aria-hidden="true">↓</span>
      </a>
    </nav>
  </div>
  <figcaption id="hn-caption">Six categories of nesting software, judged on the job every one of them assumes: true-shape parts on a fresh rectangular sheet.</figcaption>
</figure>

<script>
  const SPEED = 1500; // SVG units per second along the cut path
  const RAPID = 70; // ms for the head to jump between parts
  const HOLD = 2600; // ms to admire the finished sheet before re-running

  document.querySelectorAll<HTMLElement>('.hn').forEach((fig) => {
    const parts = [...fig.querySelectorAll<SVGPathElement>('.hn-part')];
    // the laser overlay reuses each part's outline instead of shipping the geometry twice
    const cutLayer = fig.querySelector('.hn-cuts')!;
    const cuts = parts.map((p) => {
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      c.setAttribute('class', 'hn-cut');
      c.setAttribute('d', p.getAttribute('d')!);
      return cutLayer.appendChild(c);
    });
    const dot = fig.querySelector<SVGGElement>('.hn-head-dot')!;
    const rapid = fig.querySelector<SVGPathElement>('.hn-rapid')!;
    const count = fig.querySelector<HTMLElement>('.hn-count')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lengths = cuts.map((c) => c.getTotalLength());

    const setCount = (n: number) => {
      count.textContent = String(n);
      fig.style.setProperty('--cut', String(n / cuts.length));
    };

    if (reduced) {
      fig.classList.add('is-in', 'is-done');
      parts.forEach((p) => p.classList.add('is-cut'));
      setCount(cuts.length);
      return;
    }

    cuts.forEach((c, i) => {
      c.style.strokeDasharray = `${lengths[i]}`;
      c.style.strokeDashoffset = `${lengths[i]}`;
    });

    let visible = false;
    let raf = 0;
    let started = false;
    // timeline state
    let idx = 0;
    let phase: 'rapid' | 'cut' | 'hold' = 'rapid';
    let phaseStart = 0;
    let from = { x: 300, y: -40 };

    const at = (i: number, len: number) => cuts[i].getPointAtLength(len);
    const place = (p: { x: number; y: number }) => dot.setAttribute('transform', `translate(${p.x} ${p.y})`);

    const reset = () => {
      cuts.forEach((c, i) => (c.style.strokeDashoffset = `${lengths[i]}`));
      parts.forEach((p) => p.classList.remove('is-cut'));
      fig.classList.remove('is-done');
      setCount(0);
      idx = 0;
      phase = 'rapid';
    };

    const tick = (now: number) => {
      if (!phaseStart) phaseStart = now;
      const t = now - phaseStart;

      if (phase === 'rapid') {
        const to = at(idx, 0);
        const k = Math.min(1, t / RAPID);
        const e = k * (2 - k);
        place({ x: from.x + (to.x - from.x) * e, y: from.y + (to.y - from.y) * e });
        rapid.setAttribute('d', `M${from.x},${from.y}L${to.x},${to.y}`);
        rapid.style.opacity = String(0.6 * (1 - k));
        fig.classList.remove('is-firing');
        if (k === 1) { phase = 'cut'; phaseStart = now; }
      } else if (phase === 'cut') {
        const len = lengths[idx];
        const d = Math.min(len, (t / 1000) * SPEED);
        cuts[idx].style.strokeDashoffset = String(len - d);
        place(at(idx, d));
        fig.classList.add('is-firing');
        if (d >= len) {
          parts[idx].classList.add('is-cut');
          setCount(idx + 1);
          from = at(idx, len);
          idx += 1;
          phaseStart = now;
          if (idx >= cuts.length) {
            phase = 'hold';
            fig.classList.remove('is-firing');
            fig.classList.add('is-done');
          } else {
            phase = 'rapid';
          }
        }
      } else if (t > HOLD) {
        reset();
        phaseStart = now;
      }
      raf = requestAnimationFrame(tick);
    };

    const run = () => {
      cancelAnimationFrame(raf);
      phaseStart = 0;
      fig.classList.add('is-running');
      raf = requestAnimationFrame(tick);
    };

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible && !started) {
          started = true;
          fig.classList.add('is-in');
          // wait for the sheet to draw and the parts to land before firing the laser
          window.setTimeout(() => visible && run(), 2300);
        } else if (visible && started) {
          run();
        } else {
          cancelAnimationFrame(raf);
          fig.classList.remove('is-firing');
        }
      },
      { threshold: 0.3 },
    ).observe(fig);
  });
</script>

<style>
  .hn {
    --blue: #1941df;
    --pale: #e8ecfc;
    --ink: #0a0a08;
    --muted: #4a4f5c;
    --soft: #8a9099;
    --line: #dde1f0;
    --warn: #a43228;
    --ease: cubic-bezier(.2, .8, .2, 1);
    margin: 40px auto 0;
    width: min(1040px, calc(100% - 40px));
  }
  .hn-card { display: grid; grid-template-columns: minmax(0, 1fr) 290px; background: white; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; }
  .hn-label { font: 11px 'DM Mono', monospace; letter-spacing: .09em; text-transform: uppercase; color: var(--muted); }

  /* sheet side */
  .hn-main { display: flex; flex-direction: column; min-width: 0; }
  .hn-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 24px 0; }
  .hn-badge { padding: 4px 10px; background: var(--pale); color: var(--blue); font: 11px 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; border-radius: 2px; white-space: nowrap; }
  .hn-svg { display: block; width: 100%; height: auto; padding: 22px 18px 10px 26px; overflow: visible; }

  .hn-dim { opacity: 0; transition: opacity .6s .4s; }
  .hn-dim line { stroke: var(--soft); stroke-width: 1; }
  .hn-dim text { font: 11px 'DM Mono', monospace; fill: var(--soft); }
  .hn-sheet { fill: #f4f6fb; fill-opacity: 0; stroke: #9aa3b5; stroke-width: 1.5; stroke-opacity: 0; stroke-dasharray: 100 101; stroke-dashoffset: 101; transition: stroke-dashoffset 1.1s var(--ease), fill-opacity .6s .6s; }

  .hn-part {
    fill: var(--pale); fill-opacity: .55; fill-rule: evenodd; stroke: var(--blue); stroke-opacity: .65; stroke-width: .8; stroke-dasharray: 2 2; stroke-linejoin: round;
    transform-box: fill-box; transform-origin: center; opacity: 0; transform: translateY(-14px) scale(.85);
    transition: fill-opacity .35s, stroke-opacity .35s;
  }
  .hn-part.is-cut { fill-opacity: 1; stroke-opacity: 0; }
  .hn.is-in .hn-dim { opacity: 1; }
  .hn.is-in .hn-sheet { stroke-opacity: 1; stroke-dashoffset: 0; fill-opacity: 1; }
  .hn.is-in .hn-part { opacity: 1; transform: none; transition: opacity .45s calc(.7s + var(--i) * 12ms), transform .6s calc(.7s + var(--i) * 12ms) var(--ease), fill-opacity .35s, stroke-opacity .35s; }

  .hn-cuts :global(.hn-cut) { fill: none; stroke: var(--blue); stroke-width: 1; stroke-linejoin: round; }
  .hn-leftover { opacity: 0; transition: opacity .6s; }
  .hn-leftover rect { fill: none; stroke: var(--soft); stroke-width: 1; stroke-dasharray: 4 4; }
  .hn-leftover text { font: 500 10px 'DM Mono', monospace; letter-spacing: .08em; fill: var(--soft); }
  .hn.is-done .hn-leftover { opacity: 1; }
  .hn.is-done .hn-cuts :global(.hn-cut) { transition: stroke-dashoffset .6s; }
  .hn-rapid { fill: none; stroke: var(--soft); stroke-width: 1; stroke-dasharray: 2 3; opacity: 0; }
  .hn-head-dot { opacity: 0; transition: opacity .3s; }
  .hn-head-dot circle:first-child { opacity: .25; transition: opacity .15s; }
  .hn.is-running .hn-head-dot { opacity: 1; }
  .hn.is-done .hn-head-dot { opacity: 0; }
  .hn.is-firing .hn-head-dot circle:first-child { opacity: 1; animation: hn-flicker .12s steps(2) infinite; }
  .hn-spark { fill: #ff6a3d; }
  @keyframes hn-flicker { 50% { opacity: .75; } }

  .hn-readout { display: flex; flex-wrap: wrap; gap: 8px 28px; align-items: center; margin-top: auto; padding: 14px 24px 18px; border-top: 1px solid var(--line); font: 12px 'DM Mono', monospace; color: var(--soft); }
  .hn-readout b { font-weight: 500; color: var(--ink); }
  .hn-progress { display: flex; align-items: center; gap: 6px; margin-left: auto; }
  .hn-progress i { display: block; width: 90px; height: 3px; margin-left: 8px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .hn-progress em { display: block; height: 100%; background: var(--blue); transform-origin: left; transform: scaleX(var(--cut, 0)); transition: transform .2s; }

  /* categories */
  .hn-cats { display: flex; flex-direction: column; padding: 18px 22px 22px; border-left: 1px solid var(--line); background: #fafbff; }
  .hn-cats ol { list-style: none; margin: 12px 0 0; padding: 0; }
  .hn-cats li + li { border-top: 1px solid var(--line); }
  .hn-cats li a { display: flex; gap: 12px; padding: 10px 0; text-decoration: none; color: inherit; }
  .hn-num { font: 11px/20px 'DM Mono', monospace; color: var(--blue); }
  .hn-cats strong { display: block; font: 600 14px/1.35 'DM Sans', sans-serif; color: var(--ink); transition: color .2s; }
  .hn-cats small { display: block; margin-top: 1px; font: 11.5px/1.4 'DM Mono', monospace; color: var(--soft); }
  .hn-cats li a:hover strong { color: var(--blue); }

  .hn-gap { position: relative; display: block; margin-top: 14px; padding: 12px 34px 12px 14px; background: #fdf2f2; border-left: 3px solid var(--warn); border-radius: 0 3px 3px 0; text-decoration: none; }
  .hn-gap .hn-label { color: var(--warn); font-weight: 500; }
  .hn-gap strong { margin-top: 3px; color: #5c1813; }
  .hn-arrow { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font: 14px 'DM Mono', monospace; color: var(--warn); transition: transform .2s; }
  .hn-gap:hover .hn-arrow { transform: translateY(-30%); }

  .hn :is(a):focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .hn figcaption { margin-top: 14px; font-size: 13px; line-height: 1.6; color: var(--muted); text-align: center; }

  @media (max-width: 860px) {
    .hn-card { grid-template-columns: minmax(0, 1fr); }
    .hn-cats { border-left: 0; border-top: 1px solid var(--line); }
    .hn-cats ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; }
    .hn-cats li + li { border-top: 0; }
    .hn-cats li { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 640px) {
    .hn-head { padding: 14px 16px 0; }
    .hn-badge { display: none; }
    .hn-svg { padding: 20px 10px 8px 18px; }
    .hn-readout { padding: 12px 16px 14px; gap: 6px 16px; }
    .hn-progress { margin-left: 0; }
    .hn-cats { padding: 16px; }
    .hn-cats ol { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hn *, .hn *::before { transition: none !important; animation: none !important; }
    .hn-part { opacity: 1; transform: none; }
    .hn-sheet { stroke-opacity: 1; stroke-dashoffset: 0; fill-opacity: 1; }
  }
</style>
