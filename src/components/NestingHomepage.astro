---
const { translations, locales = [], localeGroups = [], lang = 'en' } = Astro.props;
const t = translations;
const localeLabel = lang === 'es' ? 'Idioma' : 'Language';
const currentLocale = locales.find((locale) => locale.lang === lang);
const homeHref = currentLocale?.nestingHref ?? (lang === 'es' ? '/es/nesting' : '/nesting');
const factoryHref = currentLocale?.factoryHref ?? (lang === 'es' ? '/es' : '/');
const languageGroups = localeGroups.map((group) => ({
  label: group.label,
  items: group.items.map((locale) => ({
    ...locale,
    active: locale.lang === lang,
  })),
}));

const mobileLanguages = languageGroups.flatMap((group) => group.items);
---

<main class="nesting-homepage">
  <nav class="site-nav">
    <a href={homeHref} class="nav-logo" aria-label={t.meta.title}>
      <svg width="72" height="22" viewBox="0 0 107 33" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path fill="currentColor" fill-rule="nonzero" d="M-0.476,32.2 L-0.476,0.2 L4.68974586,0.2 L4.68974586,13.6857143 L11.2643315,0.2 L16.4300773,0.2 L10.2781436,11.9485714 L16.524,32.2 L11.1234475,32.2 L6.7560442,17.9371429 L4.68974586,22.0057143 L4.68974586,32.2 L-0.476,32.2 Z M18.524,32.2 L18.524,0.2 L32.524,0.2 L32.524,4.77142857 L23.6573333,4.77142857 L23.6573333,13.2285714 L30.704,13.2285714 L30.704,17.8 L23.6573333,17.8 L23.6573333,27.6285714 L32.524,27.6285714 L32.524,32.2 L18.524,32.2 Z M35.524,32.2 L35.524,0.2 L41.924,0.2 L46.8863188,19.3542857 L46.9790725,19.3542857 L46.9790725,0.2 L51.524,0.2 L51.524,32.2 L46.2834203,32.2 L40.1616812,8.84 L40.0689275,8.84 L40.0689275,32.2 L35.524,32.2 Z M53.524,32.2 L53.524,27.72 L63.0271056,4.77142857 L53.9898385,4.77142857 L53.9898385,0.2 L68.524,0.2 L68.524,4.68 L59.0208944,27.6285714 L68.524,27.6285714 L68.524,32.2 L53.524,32.2 Z M70.524,32.2 L75.6645836,0.2 L82.3834164,0.2 L87.524,32.2 L82.5637878,32.2 L81.661931,25.8457143 L81.661931,25.9371429 L76.0253263,25.9371429 L75.1234695,32.2 L70.524,32.2 Z M76.524,21.2 L81.524,21.2 L79.0492525,5.2 L78.9482424,5.2 L76.524,21.2 Z M90.524,32.2 L90.524,0.2 L97.9779877,0.2 C103.039337,0.2 105.524,2.98857143 105.524,8.10857143 L105.524,11.2628571 C105.524,16.3828571 103.039337,19.1714286 97.9779877,19.1714286 L95.5853497,19.1714286 L95.5853497,32.2 L90.524,32.2 Z M95.524,14.2 L97.9768302,14.2 C99.6277736,14.2 100.524,13.455814 100.524,11.1302326 L100.524,7.26976744 C100.524,4.94418605 99.6277736,4.2 97.9768302,4.2 L95.524,4.2 L95.524,14.2 Z"/>
      </svg>
      <span class="nav-logo-divider"></span>
      <span class="nav-logo-suffix">Nesting</span>
    </a>

    <div class="nav-links">
      <a href="#workflow">{t.nav.workflow}</a>
      <a href="#features">{t.nav.features}</a>
      <a href={factoryHref}>{t.nav.factory}</a>
      <div class="lang-switcher" id="langSwitcher">
        <button class="lang-btn" type="button" aria-label={localeLabel} aria-expanded="false">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          <span>{currentLocale?.code ?? lang.toUpperCase()}</span>
          <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="lang-dropdown">
          {languageGroups.map((group) => (
            <>
              <div class="lang-group-label">{group.label}</div>
              {group.items.map((item) => (
                <a class:list={['lang-option', item.active && 'active']} href={item.href}>
                  {item.label}
                  <span class="lang-code">{item.code}</span>
                </a>
              ))}
            </>
          ))}
        </div>
      </div>
      <a href={t.nav.ctaHref} class="nav-cta">{t.nav.cta}</a>
    </div>

    <div class="nav-mobile">
      <button id="hamburger" type="button" aria-label="Open menu" aria-expanded="false">
        <svg class="menu-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobileMenu">
    <a href="#workflow">{t.nav.workflow}</a>
    <a href="#features">{t.nav.features}</a>
    <a href={factoryHref}>{t.nav.factoryMobile}</a>
    <a href={t.nav.ctaHref} class="mobile-menu-cta">{t.nav.cta}</a>
    <div class="mobile-lang-section">
      <div class="mobile-lang-label">{localeLabel}</div>
      <div class="mobile-lang-grid">
        {mobileLanguages.map((item) => (
          <a class:list={['mobile-lang-item', item.active && 'active']} href={item.href}>{item.label}</a>
        ))}
      </div>
    </div>
  </div>

  <section class="hero">
    <div class="hero-left">
      <div class="hero-eyebrow">{t.hero.eyebrow}</div>
      <h1 class="hero-headline">{t.hero.headlineLine1}<br />{t.hero.headlineLine2Prefix}<em>{t.hero.headlineLine2Accent}</em>.<br />{t.hero.headlineLine3}</h1>
      <p class="hero-sub">{t.hero.subheadline}</p>
      <div class="hero-actions">
        <a href={t.hero.primaryCtaHref} class="btn-primary">{t.hero.primaryCta}</a>
        <a href={t.hero.secondaryCtaHref} class="btn-secondary">{t.hero.secondaryCta}</a>
      </div>
      <div class="platform-badges">
        <span class="badge"><span class="badge-icon" set:html={'<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M3 5.5L11 4.3V11.5H3V5.5ZM12 4.15L21 2.8V11.5H12V4.15ZM3 12.5H11V19.7L3 18.5V12.5ZM12 12.5H21V21.2L12 19.85V12.5Z"/></svg>'}></span>{t.hero.badges.windows}</span>
        <span class="badge"><span class="badge-icon" set:html={'<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 11.3c-.03-2.54 2.08-3.77 2.17-3.83-1.18-1.73-3.02-1.97-3.68-2-1.57-.16-3.07.93-3.86.93-.8 0-2.03-.91-3.34-.88-1.71.02-3.3 1-4.18 2.53-1.79 3.1-.46 7.69 1.28 10.21.85 1.23 1.86 2.61 3.19 2.56 1.28-.05 1.77-.83 3.32-.83 1.55 0 1.99.83 3.34.8 1.38-.02 2.25-1.25 3.09-2.49.98-1.42 1.38-2.8 1.4-2.87-.03-.01-2.7-1.04-2.73-4.13zM14.44 3.67c.71-.86 1.18-2.06 1.05-3.25-1.01.04-2.24.68-2.96 1.52-.65.75-1.22 1.95-1.07 3.1 1.13.09 2.27-.57 2.98-1.37z"/></svg>'}></span>{t.hero.badges.mac}</span>
        <span class="badge">{t.hero.badges.openSource}</span>
      </div>
    </div>
    <div class="hero-right">
      <video autoplay loop muted playsinline>
        <source src="/024.webm" type="video/webm" />
      </video>
      <div class="hero-right-label">{t.hero.previewLabel}</div>
    </div>
  </section>

  <section class="workflow" id="workflow">
    <div class="workflow-inner">
      <div class="section-label">{t.workflow.label}</div>
      <h2 class="section-title">{t.workflow.titleLine1}<br />{t.workflow.titleLine2}</h2>
      <div class="workflow-steps">
        {t.workflow.steps.map((step, index) => (
          <div class="step"><div class="step-num">{String(index + 1).padStart(2, '0')}</div><div class="step-title">{step.title}</div><div class="step-desc">{step.description}</div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="features-wrap" id="features">
    <div class="features">
      <div class="section-label">{t.features.label}</div>
      <h2 class="section-title">{t.features.titleLine1}<br />{t.features.titleLine2}</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-tag">{t.features.cards.performance.tag}</div>
          <div class="feature-title">{t.features.cards.performance.title}</div>
          <div class="feature-desc">{t.features.cards.performance.description}</div>
        </div>
        <div class="feature-card">
          <div class="feature-tag">{t.features.cards.dxf.tag}</div>
          <div class="feature-title">{t.features.cards.dxf.title}</div>
          <div class="feature-desc">{t.features.cards.dxf.description}</div>
          <div class="geo-chips">
            {t.features.cards.dxf.chips.map((chip) => <span class="geo-chip">{chip}</span>)}
          </div>
        </div>
        <div class="feature-card">
          <div class="feature-tag">{t.features.cards.engraving.tag}</div>
          <div class="feature-title">{t.features.cards.engraving.title}</div>
          <div class="feature-desc">{t.features.cards.engraving.description}</div>
        </div>
        <div class="feature-card">
          <div class="feature-tag">{t.features.cards.sheet.tag}</div>
          <div class="feature-title">{t.features.cards.sheet.title}</div>
          <div class="feature-desc">{t.features.cards.sheet.description}</div>
        </div>
        <div class="feature-card wide">
          <div>
            <div class="feature-tag">{t.features.cards.workflow.tag}</div>
            <div class="feature-title">{t.features.cards.workflow.title}</div>
            <div class="feature-desc wide-desc">{t.features.cards.workflow.description}</div>
            <div class="geo-chips">
              {t.features.cards.workflow.chips.map((chip) => <span class="geo-chip">{chip}</span>)}
            </div>
          </div>
          <div class="feature-visual">
            <video autoplay loop muted playsinline>
              <source src="/024.webm" type="video/webm" />
            </video>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="erp-bridge">
    <div class="erp-bridge-inner">
      <div>
        <div class="section-label">{t.bridge.label}</div>
        <h2 class="section-title bridge-title">{t.bridge.title}</h2>
        <p class="bridge-copy">{t.bridge.copy}</p>
        <a href={factoryHref} class="btn-secondary">{t.bridge.cta}</a>
      </div>
      <div class="bridge-stack">
        <div class="bridge-card">
          <div class="bridge-label accent">{t.bridge.standaloneLabel}</div>
          <div class="bridge-name">{t.bridge.standaloneTitle}</div>
          <div class="bridge-text">{t.bridge.standaloneText}</div>
        </div>
        <div class="bridge-separator">
          <div class="line"></div>
          <div class="bridge-helper">{t.bridge.connectsTo}</div>
          <div class="line"></div>
        </div>
        <div class="bridge-card">
          <div class="bridge-label muted">{t.bridge.platformLabel}</div>
          <div class="bridge-name">{t.bridge.platformTitle}</div>
          <div class="bridge-text">{t.bridge.platformText}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="download-section" id="download">
    <div class="section-label">{t.download.label}</div>
    <h2 class="section-title download-title">{t.download.title}</h2>
    <p class="download-sub">{t.download.sub}</p>
    <div class="download-buttons">
      <a href={t.download.windows.href} class="dl-btn">
        <div>
          <span class="dl-icon" set:html={'<svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 5.5L11 4.3V11.5H3V5.5Z" fill="#7b9af5"/><path d="M12 4.15L21 2.8V11.5H12V4.15Z" fill="#7b9af5"/><path d="M3 12.5H11V19.7L3 18.5V12.5Z" fill="#7b9af5"/><path d="M12 12.5H21V21.2L12 19.85V12.5Z" fill="#7b9af5"/></svg>'}></span>
          <div>
            <span class="dl-os">{t.download.windows.os}</span>
            <span class="dl-label">{t.download.windows.label}</span>
            <span class="dl-note">{t.download.windows.note}</span>
          </div>
        </div>
      </a>
      <a href={t.download.mac.href} class="dl-btn">
        <div>
          <span class="dl-icon" set:html={'<svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17.05 11.3c-.03-2.54 2.08-3.77 2.17-3.83-1.18-1.73-3.02-1.97-3.68-2-1.57-.16-3.07.93-3.86.93-.8 0-2.03-.91-3.34-.88-1.71.02-3.3 1-4.18 2.53-1.79 3.1-.46 7.69 1.28 10.21.85 1.23 1.86 2.61 3.19 2.56 1.28-.05 1.77-.83 3.32-.83 1.55 0 1.99.83 3.34.8 1.38-.02 2.25-1.25 3.09-2.49.98-1.42 1.38-2.8 1.4-2.87-.03-.01-2.7-1.04-2.73-4.13z" fill="#7b9af5"/><path d="M14.44 3.67c.71-.86 1.18-2.06 1.05-3.25-1.01.04-2.24.68-2.96 1.52-.65.75-1.22 1.95-1.07 3.1 1.13.09 2.27-.57 2.98-1.37z" fill="#7b9af5"/></svg>'}></span>
          <div>
            <span class="dl-os">{t.download.mac.os}</span>
            <span class="dl-label">{t.download.mac.label}</span>
            <span class="dl-note">{t.download.mac.note}</span>
          </div>
        </div>
      </a>
    </div>
    <div class="open-source-note">{t.download.openSourcePrefix} <a href={t.download.openSourceHref}>{t.download.openSourceLink}</a> · {t.download.openSourceLicense}</div>
  </section>

  <footer class="site-footer">
    <a href={factoryHref} aria-label="Kenzap">
      <svg width="60" height="18" viewBox="0 0 107 33" xmlns="http://www.w3.org/2000/svg">
        <path fill="currentColor" fill-rule="nonzero" d="M-0.476,32.2 L-0.476,0.2 L4.68974586,0.2 L4.68974586,13.6857143 L11.2643315,0.2 L16.4300773,0.2 L10.2781436,11.9485714 L16.524,32.2 L11.1234475,32.2 L6.7560442,17.9371429 L4.68974586,22.0057143 L4.68974586,32.2 L-0.476,32.2 Z M18.524,32.2 L18.524,0.2 L32.524,0.2 L32.524,4.77142857 L23.6573333,4.77142857 L23.6573333,13.2285714 L30.704,13.2285714 L30.704,17.8 L23.6573333,17.8 L23.6573333,27.6285714 L32.524,27.6285714 L32.524,32.2 L18.524,32.2 Z M35.524,32.2 L35.524,0.2 L41.924,0.2 L46.8863188,19.3542857 L46.9790725,19.3542857 L46.9790725,0.2 L51.524,0.2 L51.524,32.2 L46.2834203,32.2 L40.1616812,8.84 L40.0689275,8.84 L40.0689275,32.2 L35.524,32.2 Z M53.524,32.2 L53.524,27.72 L63.0271056,4.77142857 L53.9898385,4.77142857 L53.9898385,0.2 L68.524,0.2 L68.524,4.68 L59.0208944,27.6285714 L68.524,27.6285714 L68.524,32.2 L53.524,32.2 Z M70.524,32.2 L75.6645836,0.2 L82.3834164,0.2 L87.524,32.2 L82.5637878,32.2 L81.661931,25.8457143 L81.661931,25.9371429 L76.0253263,25.9371429 L75.1234695,32.2 L70.524,32.2 Z M76.524,21.2 L81.524,21.2 L79.0492525,5.2 L78.9482424,5.2 L76.524,21.2 Z M90.524,32.2 L90.524,0.2 L97.9779877,0.2 C103.039337,0.2 105.524,2.98857143 105.524,8.10857143 L105.524,11.2628571 C105.524,16.3828571 103.039337,19.1714286 97.9779877,19.1714286 L95.5853497,19.1714286 L95.5853497,32.2 L90.524,32.2 Z M95.524,14.2 L97.9768302,14.2 C99.6277736,14.2 100.524,13.455814 100.524,11.1302326 L100.524,7.26976744 C100.524,4.94418605 99.6277736,4.2 97.9768302,4.2 L95.524,4.2 L95.524,14.2 Z"/>
      </svg>
    </a>
    <div class="footer-links">
      <a href="/nesting-support">Support</a>
      <span class="separator">·</span>
      <a href={factoryHref}>{t.footer.factory}</a>
      <span class="separator">·</span>
      <a href="/privacy-policy">Privacy Policy</a>
      <span class="separator">·</span>
      <a href={t.footer.emailHref}>{t.footer.email}</a>
    </div>
    <div class="footer-meta">
      <div class="footer-socials">
        <a href="https://www.linkedin.com/company/kenzap" class="footer-social" aria-label="LinkedIn" target="_blank" rel="noopener" set:html={'<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>'} />
        <a href="https://github.com/kenzap/nesting-app" class="footer-social" aria-label="GitHub" target="_blank" rel="noopener" set:html={'<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>'} />
        <a href="https://www.youtube.com/c/KenzapCloud" class="footer-social" aria-label="YouTube" target="_blank" rel="noopener" set:html={'<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#f6f7fc"/></svg>'} />
      </div>
      <div class="footer-copy">{t.footer.company}</div>
    </div>
  </footer>
</main>

<script>
  const langSwitcher = document.getElementById('langSwitcher');
  const langButton = langSwitcher?.querySelector('.lang-btn');
  const mobileMenu = document.getElementById('mobileMenu');
  const hamburger = document.getElementById('hamburger');

  langButton?.addEventListener('click', () => {
    const open = langSwitcher?.classList.toggle('open');
    langButton.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  document.addEventListener('click', (event) => {
    if (langSwitcher && !langSwitcher.contains(event.target)) {
      langSwitcher.classList.remove('open');
      langButton?.setAttribute('aria-expanded', 'false');
    }
  });

  const closeMobileMenu = () => {
    mobileMenu?.classList.remove('open');
    hamburger?.setAttribute('aria-expanded', 'false');
    hamburger.innerHTML = '<svg class="menu-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>';
  };

  hamburger?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
    hamburger.innerHTML = open
      ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>'
      : '<svg class="menu-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>';
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      closeMobileMenu();
    });
  });
</script>

<style>
  :global(body) {
    background: #f6f7fc;
    color: #0a0a08;
    font-family: 'DM Sans', sans-serif;
    font-weight: 300;
    line-height: 1.6;
    overflow-x: hidden;
  }

  .nesting-homepage {
    --black: #0a0a08;
    --off-white: #f0f2fa;
    --warm-white: #f6f7fc;
    --steel-mid: #4a4f5c;
    --steel-light: #8a9099;
    --accent: #1941df;
    --accent-hover: #2d55f5;
    --accent-pale: #e8ecfc;
    --grid: #dde1f0;
    --mono: 'DM Mono', monospace;
    --display: 'Syne', sans-serif;
