---
const { translations, locales = [], localeGroups = [], lang = 'en' } = Astro.props;
const t = translations;
const localeLabel = lang === 'es' ? 'Idioma' : 'Language';
const currentLocale = locales.find((locale) => locale.lang === lang);
const homeHref = currentLocale?.factoryHref ?? (lang === 'es' ? '/es' : '/');
const languageGroups = localeGroups.map((group) => ({
  label: group.label,
  items: group.items.map((locale) => ({
    ...locale,
    active: locale.lang === lang,
  })),
}));

const mobileLanguages = languageGroups.flatMap((group) => group.items);

const featureIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="m9 12 2 2 4-4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><rect x="7" y="7" width="4" height="5" rx="1"/><rect x="13" y="7" width="4" height="3" rx="1"/><rect x="13" y="12" width="4" height="4" rx="1"/><rect x="7" y="14" width="4" height="3" rx="1"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
];

const deploymentIcons = [
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 15a4 4 0 0 0 4 4h9a5 5 0 1 0-.1-9.999 5.002 5.002 0 0 0-9.78 2.096A4.001 4.001 0 0 0 3 15Z"/></svg>',
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>',
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
];

const contactIcons = {
  linkedin:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>',
  email:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>',
};

const platformIcons = {
  Windows:
    '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 5.5L11 4.3V11.5H3V5.5ZM12 4.15L21 2.8V11.5H12V4.15ZM3 12.5H11V19.7L3 18.5V12.5ZM12 12.5H21V21.2L12 19.85V12.5Z"/></svg>',
  macOS:
    '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 11.3c-.03-2.54 2.08-3.77 2.17-3.83-1.18-1.73-3.02-1.97-3.68-2-1.57-.16-3.07.93-3.86.93-.8 0-2.03-.91-3.34-.88-1.71.02-3.3 1-4.18 2.53-1.79 3.1-.46 7.69 1.28 10.21.85 1.23 1.86 2.61 3.19 2.56 1.28-.05 1.77-.83 3.32-.83 1.55 0 1.99.83 3.34.8 1.38-.02 2.25-1.25 3.09-2.49.98-1.42 1.38-2.8 1.4-2.87-.03-.01-2.7-1.04-2.73-4.13zM14.44 3.67c.71-.86 1.18-2.06 1.05-3.25-1.01.04-2.24.68-2.96 1.52-.65.75-1.22 1.95-1.07 3.1 1.13.09 2.27-.57 2.98-1.37z"/></svg>',
};

const footerIcons = {
  linkedin:
    '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>',
  github:
    '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>',
  youtube:
    '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#f6f7fc"/></svg>',
};
---

<main class="factory-homepage">
  <nav class="site-nav">
    <a href={homeHref} class="nav-logo" aria-label="Kenzap Factory">
      <svg width="72" height="22" viewBox="0 0 107 33" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path fill="currentColor" fill-rule="nonzero" d="M-0.476,32.2 L-0.476,0.2 L4.68974586,0.2 L4.68974586,13.6857143 L11.2643315,0.2 L16.4300773,0.2 L10.2781436,11.9485714 L16.524,32.2 L11.1234475,32.2 L6.7560442,17.9371429 L4.68974586,22.0057143 L4.68974586,32.2 L-0.476,32.2 Z M18.524,32.2 L18.524,0.2 L32.524,0.2 L32.524,4.77142857 L23.6573333,4.77142857 L23.6573333,13.2285714 L30.704,13.2285714 L30.704,17.8 L23.6573333,17.8 L23.6573333,27.6285714 L32.524,27.6285714 L32.524,32.2 L18.524,32.2 Z M35.524,32.2 L35.524,0.2 L41.924,0.2 L46.8863188,19.3542857 L46.9790725,19.3542857 L46.9790725,0.2 L51.524,0.2 L51.524,32.2 L46.2834203,32.2 L40.1616812,8.84 L40.0689275,8.84 L40.0689275,32.2 L35.524,32.2 Z M53.524,32.2 L53.524,27.72 L63.0271056,4.77142857 L53.9898385,4.77142857 L53.9898385,0.2 L68.524,0.2 L68.524,4.68 L59.0208944,27.6285714 L68.524,27.6285714 L68.524,32.2 L53.524,32.2 Z M70.524,32.2 L75.6645836,0.2 L82.3834164,0.2 L87.524,32.2 L82.5637878,32.2 L81.661931,25.8457143 L81.661931,25.9371429 L76.0253263,25.9371429 L75.1234695,32.2 L70.524,32.2 Z M76.524,21.2 L81.524,21.2 L79.0492525,5.2 L78.9482424,5.2 L76.524,21.2 Z M90.524,32.2 L90.524,0.2 L97.9779877,0.2 C103.039337,0.2 105.524,2.98857143 105.524,8.10857143 L105.524,11.2628571 C105.524,16.3828571 103.039337,19.1714286 97.9779877,19.1714286 L95.5853497,19.1714286 L95.5853497,32.2 L90.524,32.2 Z M95.524,14.2 L97.9768302,14.2 C99.6277736,14.2 100.524,13.455814 100.524,11.1302326 L100.524,7.26976744 C100.524,4.94418605 99.6277736,4.2 97.9768302,4.2 L95.524,4.2 L95.524,14.2 Z"/>
      </svg>
      <span class="nav-logo-divider"></span>
      <span class="nav-logo-suffix">Factory</span>
    </a>

    <div class="nav-links">
      <a href="#problem">{t.nav.problem}</a>
      <a href="#features">{t.nav.features}</a>
      <a href="#case-study">{t.nav.caseStudy}</a>
      <a href={t.nav.nestingHref}>{t.nav.nesting}</a>
      <div class="lang-switcher" id="langSwitcher">
        <button class="lang-btn" type="button" aria-label="Select language" aria-expanded="false">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          <span>{currentLocale?.code ?? lang.toUpperCase()}</span>
          <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="lang-dropdown">
          {languageGroups.map((group) => (
            <>
              <div class="lang-group-label">{group.label}</div>
              {group.items.map((item) => (
                <a class:list={['lang-option', item.active && 'active']} href={item.href}>
                  {item.label}
                  <span class="lang-code">{item.code}</span>
                </a>
              ))}
            </>
          ))}
        </div>
      </div>
      <a href="#contact" class="nav-cta">{t.nav.cta}</a>
    </div>

    <div class="nav-mobile">
      <button id="hamburger" type="button" aria-label="Open menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobileMenu">
    <a href="#problem">{t.nav.problem}</a>
    <a href="#features">{t.nav.features}</a>
    <a href="#case-study">{t.nav.caseStudy}</a>
    <a href={t.nav.nestingHref}>{t.nav.nesting}</a>
    <a href="#contact" class="mobile-menu-cta">{t.nav.cta}</a>

    <div class="mobile-lang-section">
      <div class="mobile-lang-label">{localeLabel}</div>
      <div class="mobile-lang-grid">
        {mobileLanguages.map((item) => (
          <a class:list={['mobile-lang-item', item.active && 'active']} href={item.href}>{item.label}</a>
        ))}
      </div>
    </div>
  </div>

  <section class="hero">
    <div class="hero-left">
      <div class="hero-eyebrow">{t.hero.eyebrow}</div>
      <h1 class="hero-headline">
        {t.hero.headlineTop}<br />
        <span class="strike-word">{t.hero.strikeWord}</span><br />
        <em>{t.hero.headlineAccent}</em>
      </h1>
      <p class="hero-sub">{t.hero.subheadline}</p>
      <div class="hero-actions">
        <a href="#contact" class="btn-primary">{t.hero.primaryCta}</a>
        <a href="#case-study" class="btn-secondary">{t.hero.secondaryCta}</a>
      </div>
      <div class="hero-stats">
        {t.hero.stats.map((stat) => (
          <div>
            <div class="hero-stat-num"><span>{stat.value}</span></div>
            <div class="hero-stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
    <div class="hero-right">
      <video autoplay loop muted playsinline poster="/favicon.png">
        <source src="/025.webm" type="video/webm" />
      </video>
      <div class="hero-right-overlay"></div>
      <div class="hero-right-label">{t.hero.interfaceLabel}</div>
    </div>
  </section>

  <section class="pain" id="problem">
    <div class="container">
      <div class="section-label light">{t.problem.label}</div>
      <h2 class="section-title light-title">{t.problem.title}</h2>
      <div class="pain-grid">
        <div class="pain-list">
          {t.problem.items.map((item, index) => (
            <div class="pain-item">
              <span class="pain-num">{String(index + 1).padStart(2, '0')}</span>
              <span class="pain-text"><strong>{item.title}</strong> {item.description}</span>
            </div>
          ))}
        </div>
        <div class="pain-callout">
          <div class="pain-callout-quote">{t.problem.quote}</div>
          <div class="pain-callout-attr">{t.problem.quoteAuthor}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="workflow" id="workflow">
    <div class="container">
      <div class="section-label">{t.workflow.label}</div>
      <h2 class="section-title">{t.workflow.title}</h2>
      <div class="workflow-steps">
        {t.workflow.steps.map((step, index) => (
          <div class="step">
            <div class="step-num">{String(index + 1).padStart(2, '0')}</div>
            <div class="step-title">{step.title}</div>
            <div class="step-desc">{step.description}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="features-section" id="features">
    <div class="container">
      <div class="section-label">{t.features.label}</div>
      <h2 class="section-title">{t.features.title}</h2>
      <div class="features-grid">
        {t.features.items.map((feature, index) => (
          <div class:list={['feature-card', feature.accent && 'fc-accent']}>
            <div class="fc-icon" set:html={featureIcons[index]} />
            <div class="feature-tag">{feature.tag}</div>
            <div class="feature-title">{feature.title}</div>
            <div class="feature-desc">{feature.description}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="case-study" id="case-study">
    <div class="container">
      <div class="section-label">{t.caseStudy.label}</div>
      <h2 class="section-title">{t.caseStudy.title}</h2>
      <div class="case-study-grid">
        <div>
          <div class="cs-meta">{t.caseStudy.meta}</div>
          <div class="cs-block">
            <div class="cs-block-label">{t.caseStudy.challengeLabel}</div>
            <div class="cs-block-text">{t.caseStudy.challengeText}</div>
          </div>
          <div class="cs-block">
            <div class="cs-block-label">{t.caseStudy.solutionLabel}</div>
            <div class="cs-block-text">{t.caseStudy.solutionText}</div>
          </div>
          <div class="cs-quote">
            <div class="cs-quote-text">{t.caseStudy.quote}</div>
            <div class="cs-quote-attr">{t.caseStudy.quoteAuthor}</div>
          </div>
        </div>
        <div>
          <div class="cs-results">
            {t.caseStudy.results.map((result) => (
              <div class:list={['cs-result', result.fullWidth && 'full-width']}>
                <div class="cs-result-num">{result.value}</div>
                <div class="cs-result-label">{result.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="deployment" id="deployment">
    <div class="container">
      <div class="section-label">{t.deployment.label}</div>
      <h2 class="section-title">{t.deployment.title}</h2>
      <div class="deploy-grid">
        {t.deployment.options.map((option, index) => (
          <div class="deploy-card">
            <div class="deploy-icon" set:html={deploymentIcons[index]} />
            <div class="deploy-title">{option.title}</div>
            <div class="deploy-desc">{option.description}</div>
          </div>
        ))}
      </div>

      <div class="section-label timeline-label-top">{t.timeline.label}</div>
      <div class="timeline-row">
        {t.timeline.phases.map((phase) => (
          <div class="timeline-cell">
            <div class="timeline-phase">{phase.phase}</div>
            <div class="timeline-weeks">{phase.duration}</div>
            <div class="timeline-label">{phase.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="nesting-cta">
    <div class="container nesting-grid">
      <div>
        <div class="section-label light">{t.nesting.label}</div>
        <h2>{t.nesting.title}</h2>
        <p>{t.nesting.description}</p>
        <a href={t.nesting.href} class="btn-ghost">{t.nesting.primaryCta}</a>
      </div>
      <div class="nesting-cta-card">
        <div class="nesting-cta-card-label">{t.nesting.cardLabel}</div>
        <div class="nesting-cta-card-title">{t.nesting.cardTitle}</div>
        <div class="nesting-cta-card-desc">{t.nesting.cardDescription}</div>
        <div class="platform-links">
          {t.nesting.platforms.map((platform) => (
            <a href={t.nesting.href} class="btn-ghost">
              <span set:html={platformIcons[platform] ?? ''} />
              {platform}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="contact-inner">
      <div class="section-label centered">{t.contact.label}</div>
      <h2 class="section-title">{t.contact.title}</h2>
      <p class="contact-sub">{t.contact.description}</p>
      <div class="contact-methods">
        <a href={t.contact.linkedinHref} class="contact-btn primary">
          <span set:html={contactIcons.linkedin} />
          {t.contact.linkedinLabel}
        </a>
        <a href={t.contact.emailHref} class="contact-btn secondary">
          <span set:html={contactIcons.email} />
          {t.contact.emailLabel}
        </a>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <a href={homeHref} aria-label="Kenzap">
      <svg width="60" height="18" viewBox="0 0 107 33" xmlns="http://www.w3.org/2000/svg">
