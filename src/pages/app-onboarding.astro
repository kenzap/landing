---
import Layout from '../layouts/Layout.astro';
---

<!--
  Netlify Forms receiver for the Kenzap Nesting desktop setup assistant.
  Netlify registers the "onboarding" form from this static markup at deploy
  time; the app (nesting-app/main/ipc/feedback.js) POSTs urlencoded data to
  this page's URL. Field names must match what the app sends: unknown
  fields are dropped. No reCAPTCHA, since the app can't solve one; the
  honeypot catches basic bots. Kept out of search via the robots meta here,
  an X-Robots-Tag header and a sitemap exclude in netlify.toml.
-->
<Layout
  title="Onboarding Receiver — Kenzap"
  description="Netlify form receiver for the Kenzap Nesting setup assistant."
  lang="en"
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <form
    name="onboarding"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    hidden
  >
    <input type="hidden" name="form-name" value="onboarding" />
    <input name="bot-field" />
    <input type="email" name="email" />
    <input name="optInFeedback" />
    <input name="optInUpdates" />
    <input name="materialType" />
    <input name="mode" />
    <input name="lengthOptimization" />
    <input name="sheetWidthMm" />
    <input name="sheetLengthMm" />
    <input name="partSpacingMm" />
    <input name="units" />
    <input name="language" />
    <input name="platform" />
    <input name="appVersion" />
    <input name="submittedAt" />
  </form>
</Layout>
