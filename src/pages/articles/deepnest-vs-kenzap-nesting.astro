<script>
  const assetBase = '/articles/deepnest-vs-kenzap-nesting';
  const shotData: Record<string, { file: string; caption: string }> = JSON.parse(document.getElementById('shot-data')?.textContent || '{}');
  const bar = document.getElementById('progress-bar')!;
  const updateProgress = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
  };
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  let zoom = 1;
  let pan = { x: 0, y: 0 };
  const drawings = [...document.querySelectorAll<HTMLElement>('.drawing')];
  const stages = [...document.querySelectorAll<HTMLElement>('.layout-stage')];
  document.querySelectorAll<SVGSVGElement>('.drawing svg').forEach((svg) => svg.setAttribute('data-overlaps', 'true'));
  const applyView = () => {
    drawings.forEach((drawing) => { drawing.style.transform = `translate(${pan.x}px, ${pan.y}px) scale(${zoom})`; });
    document.querySelector('#zoom-level')!.textContent = `${Math.round(zoom * 100)}%`;
    document.querySelector<HTMLButtonElement>('#zoom-out')!.disabled = zoom <= 1;
    document.querySelector<HTMLButtonElement>('#zoom-in')!.disabled = zoom >= 4;
    stages.forEach((stage) => stage.classList.toggle('zoomed', zoom > 1));
  };
  const setZoom = (value: number) => { zoom = Math.max(1, Math.min(4, value)); if (zoom === 1) pan = { x: 0, y: 0 }; applyView(); };
  document.querySelector('#zoom-in')?.addEventListener('click', () => setZoom(zoom + .25));
  document.querySelector('#zoom-out')?.addEventListener('click', () => setZoom(zoom - .25));
  document.querySelector('#zoom-reset')?.addEventListener('click', () => { pan = { x: 0, y: 0 }; setZoom(1); });
  for (const stage of stages) {
    let drag: { x: number; y: number; panX: number; panY: number } | null = null;
    stage.addEventListener('pointerdown', (event) => {
      if (zoom === 1 || event.button !== 0) return;
      drag = { x: event.clientX, y: event.clientY, panX: pan.x, panY: pan.y };
      stage.setPointerCapture(event.pointerId);
    });
    stage.addEventListener('pointermove', (event) => { if (drag) { pan = { x: drag.panX + event.clientX - drag.x, y: drag.panY + event.clientY - drag.y }; applyView(); } });
    stage.addEventListener('pointerup', () => { drag = null; });
    stage.addEventListener('pointercancel', () => { drag = null; });
    stage.addEventListener('keydown', (event) => {
      if (event.key === '+' || event.key === '=') { event.preventDefault(); setZoom(zoom + .25); }
      if (event.key === '-') { event.preventDefault(); setZoom(zoom - .25); }
      if (event.key === '0') { event.preventDefault(); pan = { x: 0, y: 0 }; setZoom(1); }
      if (zoom > 1 && ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) {
        event.preventDefault(); pan.x += event.key === 'ArrowLeft' ? 30 : event.key === 'ArrowRight' ? -30 : 0;
        pan.y += event.key === 'ArrowUp' ? 30 : event.key === 'ArrowDown' ? -30 : 0; applyView();
      }
    });
    stage.addEventListener('wheel', (event) => { if (event.ctrlKey || event.metaKey) { event.preventDefault(); setZoom(zoom + (event.deltaY < 0 ? .1 : -.1)); } }, { passive: false });
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-competitor]')) {
    button.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('[data-competitor]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      document.querySelectorAll<HTMLElement>('[data-layout]').forEach((panel) => { panel.hidden = panel.dataset.layout !== button.dataset.competitor; });
      document.querySelector('#layout-competitor')!.textContent = button.dataset.competitor === 'deepnest' ? 'Deepnest' : 'Deepnest-next';
    });
  }
  const dialog = document.querySelector<HTMLDialogElement>('#screenshot-dialog')!;
  const shotImage = document.querySelector<HTMLImageElement>('#shot-image')!;
  const shotOpen = document.querySelector<HTMLButtonElement>('#shot-open')!;
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-shot]')) {
    button.addEventListener('click', () => {
      const shot = shotData[button.dataset.shot!];
      if (!shot) return;
      document.querySelectorAll<HTMLButtonElement>('[data-shot]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      shotImage.src = `${assetBase}/${shot.file}`;
      shotImage.alt = shot.caption;
      shotOpen.dataset.openImage = shotImage.src;
      shotOpen.dataset.imageCaption = shot.caption;
      document.querySelector('#shot-caption')!.textContent = shot.caption;
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-open-image]').forEach((button) => button.addEventListener('click', () => {
    const img = document.querySelector<HTMLImageElement>('#dialog-image')!;
    img.src = button.dataset.openImage!; img.alt = button.dataset.imageCaption!;
    document.querySelector('#dialog-caption')!.textContent = button.dataset.imageCaption!;
    dialog.showModal();
  }));
  document.querySelector('#dialog-close')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (event) => { if (event.target === dialog) { const r = dialog.getBoundingClientRect(); if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) dialog.close(); } });
  applyView();
</script>
<script is:inline id="shot-data" type="application/json" set:html={JSON.stringify(Object.fromEntries(shots.map((s) => [s.id, { file: s.file, caption: s.caption }])))}></script>

<style>
  :global(html:has(.post)) { scroll-padding-top: 80px; }
  :global(body:has(.post)) { background: #f6f7fc; }
  .post { --ink: #0a0a08; --text: #1c1e26; --muted: #4a4f5c; --soft: #8a9099; --line: #dde1f0; --blue: #1941df; --pale: #e8ecfc; --paper: #f6f7fc; --warn: #a43228; --col: 680px; --mono: 'DM Mono', monospace; --display: 'Syne', sans-serif; background: var(--paper); color: var(--text); font-family: 'DM Sans', sans-serif; line-height: 1.7; min-height: 100vh; overflow-x: clip; }
  .post a { color: inherit; text-decoration: none; }
  .post button, .post input { font: inherit; }
  .post button { cursor: pointer; }
  .post :is(button, a, summary, input, .layout-stage, .table-scroll):focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  [hidden] { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
  .skip-link { position: fixed; z-index: 60; left: 15px; top: -60px; padding: 10px 15px; background: white; border: 1px solid var(--blue); }
  .skip-link:focus { top: 10px; }
  .label { font: 11px var(--mono); letter-spacing: .09em; text-transform: uppercase; color: var(--muted); }

  .progress { position: fixed; z-index: 50; inset: 0 0 auto 0; height: 3px; }
  .progress span { display: block; height: 100%; background: var(--blue); transform: scaleX(0); transform-origin: left; }
  .topbar { position: sticky; top: 0; z-index: 40; display: flex; justify-content: space-between; align-items: center; padding: 16px 32px; background: rgba(246,247,252,.94); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .brand { display: flex; gap: 12px; align-items: center; font-family: var(--display); font-weight: 800; }
  .brand span { border-left: 1px solid var(--line); padding-left: 12px; color: var(--blue); font: 11px var(--mono); text-transform: uppercase; letter-spacing: .07em; }
  .header-cta { background: var(--ink); color: white !important; padding: 10px 16px; font: 12px var(--mono); }
  .header-cta span { margin-left: 12px; }

  /* masthead */
  .masthead, .body, .end { width: min(var(--col), calc(100% - 40px)); margin-inline: auto; }
  .masthead { padding-top: 72px; }
  .kicker { display: flex; align-items: center; gap: 14px; font: 11px var(--mono); letter-spacing: .09em; text-transform: uppercase; color: var(--blue); }
  .draft { padding: 3px 9px; background: #eceefa; color: var(--blue); }
  h1 { font: 700 clamp(40px, 6vw, 62px)/1.05 var(--display); letter-spacing: -.055em; margin-top: 22px; color: var(--ink); }
  .deck { margin-top: 22px; font-size: clamp(20px, 2.4vw, 24px); line-height: 1.45; color: var(--muted); letter-spacing: -.012em; }
  .byline { display: flex; align-items: center; gap: 14px; margin-top: 32px; padding-block: 20px; border-block: 1px solid var(--line); }
  .byline strong { display: block; font-size: 15px; font-weight: 500; line-height: 1.3; color: var(--ink); }
  .byline span:not(.avatar) { display: block; font: 12px var(--mono); color: var(--soft); margin-top: 3px; }
  .avatar-link { flex: none; border-radius: 50%; line-height: 0; }
  .avatar-link:focus-visible, .author-link:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  .author-link:hover strong { color: var(--blue); }
  .avatar { flex: none; display: block; width: 44px; height: 44px; border-radius: 50%; object-fit: cover; background: var(--ink); }
  .avatar-lg { width: 56px; height: 56px; font-size: 22px; }

  /* body copy */
  .body { font-size: 19px; line-height: 1.8; }
  .body p { margin-top: 24px; }
  .body a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--blue); }
  .body h2 { font: 700 clamp(28px, 3.4vw, 36px)/1.15 var(--display); letter-spacing: -.045em; color: var(--ink); margin-top: 64px; }
  .body h2 + p { margin-top: 18px; }
  .lede { font-size: 25px !important; line-height: 1.5; letter-spacing: -.02em; color: var(--ink); margin-top: 36px !important; }
  .note { padding: 16px 20px; border-left: 3px solid var(--blue); background: #eceefa; font-size: 15px !important; line-height: 1.6; color: var(--muted); margin-top: 36px !important; }
  .note strong { color: var(--ink); font-weight: 500; }
  .micro { font-size: 12px !important; line-height: 1.6; color: var(--muted); }
  .pullquote { margin: 56px -40px; padding: 8px 0 8px 28px; border-left: 4px solid var(--blue); font: 600 clamp(26px, 3.4vw, 36px)/1.22 var(--display); letter-spacing: -.045em; color: var(--blue); }
  .questions { list-style: none; counter-reset: q; margin-top: 22px; border-top: 1px solid var(--line); font-size: 16px; line-height: 1.6; }
  .questions li { counter-increment: q; display: grid; grid-template-columns: 42px 190px 1fr; gap: 10px; align-items: baseline; padding: 17px 0; border-bottom: 1px solid var(--line); }
  .questions li::before { content: counter(q, decimal-leading-zero); font: 12px var(--mono); color: var(--blue); }
  .questions strong { font: 600 17px var(--display); letter-spacing: -.02em; color: var(--ink); }
  .questions span { color: var(--muted); }
  .rules { margin-top: 44px; padding: 24px 28px; border: 1px solid var(--line); background: #f0f2fa; }
  .rules dl > div { display: flex; justify-content: space-between; gap: 14px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 15px; line-height: 1.5; }
  .rules dt { color: var(--muted); }
  .rules dd { text-align: right; color: var(--ink); }
  .rules .label { margin-bottom: 6px; }
  .rules p { margin-top: 14px; font-size: 12px; line-height: 1.6; color: var(--muted); }
  /* figures */
  .figure { margin: 52px auto 0; }
  .figure-wide { width: min(1120px, calc(100% - 40px)); }
  .figure-mid { width: min(860px, calc(100% - 40px)); }
  .figure-part { width: min(var(--col), calc(100% - 40px)); padding: 24px; border: 1px solid var(--line); background: white; }
  .figure-part svg { display: block; width: 100%; max-height: 360px; }
  figcaption { margin-top: 14px; font-size: 13px; line-height: 1.6; color: var(--muted); }
  .hero-figure { margin-top: 44px; }
  .hero-figure img { display: block; width: 100%; height: auto; border: 1px solid var(--line); background: white; }
  .figure-part figcaption { text-align: center; }
  .evidence-image img { display: block; width: 100%; height: auto; border: 1px solid var(--line); }
  .video-figure { max-width: 900px; }
  .video-frame { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #10121b; }
  .video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .shot-tabs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-bottom: 14px; }
  .shot-tabs button { display: flex; flex-direction: column; gap: 4px; align-items: flex-start; text-align: left; padding: 12px 14px; border: 1px solid var(--line); background: transparent; color: var(--muted); }
  .shot-tabs button span { font: 11px var(--mono); }
  .shot-tabs button strong { font: 600 20px var(--display); letter-spacing: -.04em; color: var(--ink); }
  .shot-tabs button[aria-pressed="true"] { border-color: var(--blue); background: var(--pale); }
  .image-open { position: relative; display: block; width: 100%; padding: 0; border: 0; background: var(--line); overflow: hidden; cursor: zoom-in; }
  .image-open img { display: block; width: 100%; height: auto; }
  .image-open-label { position: absolute; bottom: 12px; right: 12px; background: rgba(246,247,252,.97); padding: 8px 12px; font: 11px var(--mono); }

  .table-scroll { overflow-x: auto; background: white; border: 1px solid var(--line); }
  table { border-collapse: collapse; width: 100%; min-width: 680px; font-size: 14px; text-align: left; }
  th, td { border-bottom: 1px solid var(--line); padding: 16px 18px; vertical-align: top; }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { font: 600 14px var(--display); color: var(--ink); width: 21%; }
  thead th:first-child { width: 37%; }
  tbody th { font-weight: 400; color: var(--muted); }
  td strong, .table-value { font: 500 22px var(--display); letter-spacing: -.04em; color: var(--ink); }
  td small { display: block; font-size: 11px; color: var(--soft); margin-top: 4px; line-height: 1.5; }
  .kenzap-col { background: var(--pale); }

  /* viewer */
  .viewer-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .segmented { display: inline-flex; border: 1px solid #cbd1e3; padding: 3px; background: var(--paper); gap: 3px; }
