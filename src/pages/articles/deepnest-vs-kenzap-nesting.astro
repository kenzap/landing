---
import { readFileSync } from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import data from '../../data/deepnest-benchmark.json';

const base = '/articles/deepnest-vs-kenzap-nesting';
const svg = (id: string) => readFileSync(new URL(`../../../public${base}/${id}.svg`, import.meta.url), 'utf8');
const kenzap = data.results.find((result) => result.id === 'kenzap')!;
const deepnest = data.results.find((result) => result.id === 'deepnest')!;
const next = data.results.find((result) => result.id === 'deepnest-next')!;

// One real part, lifted from Kenzap's supplied export, for the "part on the table" figure.
const kenzapSvg = svg('kenzap');
const partPath = kenzapSvg.match(/<path class="part" data-part="1" d="([^"]+)"/)?.[1] ?? '';
const nums = [...partPath.matchAll(/(-?\d+\.?\d*),(-?\d+\.?\d*)/g)].map((m) => [Number(m[1]), Number(m[2])]);
const xs = nums.map((n) => n[0]);
const ys = nums.map((n) => n[1]);
const pad = 24;
const partBox = nums.length
  ? `${Math.min(...xs) - pad} ${Math.min(...ys) - pad} ${Math.max(...xs) - Math.min(...xs) + pad * 2} ${Math.max(...ys) - Math.min(...ys) + pad * 2}`
  : '0 0 1 1';

const shots = [
  { id: 'kenzap', label: 'Kenzap · 45 s', count: '61 / 61', file: 'kenzap-nesting-45s.webp', caption: 'Kenzap Nesting: complete result in the 45-second capture, 61 of 61 parts.' },
  { id: 'next-45s', label: 'Deepnest-next · 45 s', count: '43 / 61', file: 'deepnest-next-45s.webp', caption: 'Deepnest-next at 45 seconds: 43 of 61 parts.' },
  { id: 'next-5m', label: 'Deepnest-next · 5 min', count: '46 / 61', file: 'deepnest-next-5m.webp', caption: 'Deepnest-next at 5 minutes: 46 of 61 parts.' },
  { id: 'next-10m', label: 'Deepnest-next · 10 min', count: '46 / 61', file: 'deepnest-next-10m.webp', caption: 'Deepnest-next at 10 minutes: still 46 of 61 parts.' },
  { id: 'deepnest', label: 'Deepnest · later', count: '55 / 61', file: 'deepnest.webp', caption: 'Original Deepnest in a later capture: 55 parts reported, with intersecting outlines. Elapsed time was not recorded.' },
];
const percent = (value: number | null) => value === null ? 'Not reported' : `${value.toFixed(1)}%`;
