---
import { readFileSync } from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import data from '../../data/deepnest-benchmark.json';

const base = '/articles/deepnest-vs-kenzap-nesting';
const svg = (id: string) => readFileSync(new URL(`../../../public${base}/${id}.svg`, import.meta.url), 'utf8');
const kenzap = data.results.find((result) => result.id === 'kenzap')!;
const deepnest = data.results.find((result) => result.id === 'deepnest')!;
const next = data.results.find((result) => result.id === 'deepnest-next')!;
const shots = [
  { id: '45s', label: '45 seconds', count: 43, file: 'deepnest-next-45s.webp' },
  { id: '5m', label: '5 minutes', count: 46, file: 'deepnest-next-5m.webp' },
  { id: '10m', label: '10 minutes', count: 46, file: 'deepnest-next-10m.webp' },
];
const percent = (value: number | null) => value === null ? 'Not reported' : `${value.toFixed(1)}%`;
---

<Layout title="Deepnest vs Kenzap Nesting: a 61-part DXF benchmark | Kenzap" description="An interactive, single-case comparison of Kenzap Nesting, Deepnest, and Deepnest-next. Inspect supplied DXFs, screenshot checkpoints, and geometry checks.">
