    <dialog id="screenshot-dialog" aria-labelledby="dialog-caption"><div class="dialog-header"><p id="dialog-caption"></p><button type="button" id="dialog-close" aria-label="Close screenshot">Close <span aria-hidden="true">×</span></button></div><img id="dialog-image" alt="" /><p class="micro">Original, unedited screenshot.</p></dialog>
  </main>
</Layout>

<script>
  let zoom = 1;
  let pan = { x: 0, y: 0 };
  const drawings = [...document.querySelectorAll<HTMLElement>('.drawing')];
  const stages = [...document.querySelectorAll<HTMLElement>('.layout-stage')];
  const applyView = () => {
    drawings.forEach((drawing) => { drawing.style.transform = `translate(${pan.x}px, ${pan.y}px) scale(${zoom})`; });
    document.querySelector('#zoom-level')!.textContent = `${Math.round(zoom * 100)}%`;
    document.querySelector<HTMLButtonElement>('#zoom-out')!.disabled = zoom <= 1;
    document.querySelector<HTMLButtonElement>('#zoom-in')!.disabled = zoom >= 4;
    stages.forEach((stage) => stage.classList.toggle('zoomed', zoom > 1));
  };
  const setZoom = (value: number) => { zoom = Math.max(1, Math.min(4, value)); if (zoom === 1) pan = { x: 0, y: 0 }; applyView(); };
  document.querySelector('#zoom-in')?.addEventListener('click', () => setZoom(zoom + .25));
  document.querySelector('#zoom-out')?.addEventListener('click', () => setZoom(zoom - .25));
  document.querySelector('#zoom-reset')?.addEventListener('click', () => { pan = { x: 0, y: 0 }; setZoom(1); });
  for (const stage of stages) {
    let drag: { x: number; y: number; panX: number; panY: number } | null = null;
    stage.addEventListener('pointerdown', (event) => {
      if (zoom === 1 || event.button !== 0) return;
      drag = { x: event.clientX, y: event.clientY, panX: pan.x, panY: pan.y };
      stage.setPointerCapture(event.pointerId);
    });
    stage.addEventListener('pointermove', (event) => { if (drag) { pan = { x: drag.panX + event.clientX - drag.x, y: drag.panY + event.clientY - drag.y }; applyView(); } });
    stage.addEventListener('pointerup', () => { drag = null; });
    stage.addEventListener('pointercancel', () => { drag = null; });
    stage.addEventListener('keydown', (event) => {
      if (event.key === '+' || event.key === '=') { event.preventDefault(); setZoom(zoom + .25); }
      if (event.key === '-') { event.preventDefault(); setZoom(zoom - .25); }
      if (event.key === '0') { event.preventDefault(); pan = { x: 0, y: 0 }; setZoom(1); }
      if (zoom > 1 && ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) {
        event.preventDefault(); pan.x += event.key === 'ArrowLeft' ? 30 : event.key === 'ArrowRight' ? -30 : 0;
        pan.y += event.key === 'ArrowUp' ? 30 : event.key === 'ArrowDown' ? -30 : 0; applyView();
      }
    });
    stage.addEventListener('wheel', (event) => { if (event.ctrlKey || event.metaKey) { event.preventDefault(); setZoom(zoom + (event.deltaY < 0 ? .1 : -.1)); } }, { passive: false });
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-competitor]')) {
    button.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('[data-competitor]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      document.querySelectorAll<HTMLElement>('[data-layout]').forEach((panel) => { panel.hidden = panel.dataset.layout !== button.dataset.competitor; });
      document.querySelector('#layout-note')!.textContent = button.dataset.competitor === 'deepnest'
        ? 'Deepnest reports 55 in its later screenshot. Its export contains 49 intact outer contours and 12 unresolved open fragments. Red highlights show confirmed intersections; fragments are not forcibly closed.'
        : "Deepnest-next's supplied DXF contains 43 parts, matching the count in its 45-second screenshot. The exact export timestamp was not independently recorded.";
    });
  }
  for (const [id, attribute] of [['outline-toggle', 'data-outlines'], ['overlap-toggle', 'data-overlaps']]) {
    const input = document.getElementById(id) as HTMLInputElement;
    input.addEventListener('change', () => { document.querySelectorAll('.drawing svg').forEach((svg) => svg.setAttribute(attribute, String(input.checked))); });
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-basis]')) {
    button.addEventListener('click', () => {
      const used = button.dataset.basis === 'used';
      document.querySelectorAll<HTMLButtonElement>('[data-basis]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      document.querySelectorAll<HTMLElement>('[data-coverage]').forEach((cell) => { cell.textContent = (used ? cell.dataset.used : cell.dataset.full)!; });
      document.querySelector('#basis-note')!.textContent = used
        ? 'Outer-envelope area ÷ each export\'s occupied bounding rectangle. Different denominators: this describes local packing density, not full-stock material yield. Cutouts are not subtracted.'
        : 'Outer-envelope area ÷ 1250 × 2500 mm. The same denominator for both complete-geometry exports; internal cutouts are not subtracted.';
    });
  }
  const checkpoints: Record<string, { file: string; time: string; count: number }> = {
    '45s': { file: 'deepnest-next-45s.webp', time: '45-second', count: 43 },
    '5m': { file: 'deepnest-next-5m.webp', time: '5-minute', count: 46 },
    '10m': { file: 'deepnest-next-10m.webp', time: '10-minute', count: 46 },
  };
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-checkpoint]')) {
    button.addEventListener('click', () => {
      const shot = checkpoints[button.dataset.checkpoint!];
      document.querySelectorAll<HTMLButtonElement>('[data-checkpoint]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      const img = document.querySelector<HTMLImageElement>('#checkpoint-image')!;
      img.src = `${base}/${shot.file}`;
      img.alt = `Deepnest-next at the labeled ${shot.time} checkpoint, reporting ${shot.count} of 61 parts.`;
      const opener = img.closest<HTMLButtonElement>('[data-open-image]')!;
      opener.dataset.openImage = img.src;
      opener.dataset.imageCaption = `Deepnest-next: ${shot.time} screenshot, ${shot.count} of 61 parts`;
      document.querySelector('#checkpoint-caption')!.textContent = `${shot.time} checkpoint · ${shot.count} of 61 parts`;
    });
  }
  const dialog = document.querySelector<HTMLDialogElement>('#screenshot-dialog')!;
  document.querySelectorAll<HTMLButtonElement>('[data-open-image]').forEach((button) => button.addEventListener('click', () => {
    const img = document.querySelector<HTMLImageElement>('#dialog-image')!;
    img.src = button.dataset.openImage!; img.alt = button.dataset.imageCaption!;
    document.querySelector('#dialog-caption')!.textContent = button.dataset.imageCaption!;
    dialog.showModal();
  }));
  document.querySelector('#dialog-close')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (event) => { if (event.target === dialog) { const r = dialog.getBoundingClientRect(); if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) dialog.close(); } });
  applyView();
</script>

